{
  "name": "auralis-desktop",
  "version": "2.3.3",
  "description": "Auralis — Liquid Glass community messenger",
  "main": "electron-main.js",
  "scripts": {
    "start": "node server.js",
    "desktop": "electron .",
    "build": "electron-builder --win",
    "build:portable": "electron-builder --win portable",
    "build:nsis": "electron-builder --win nsis",
    "preview": "node local-preview.js",
    "preview:host": "node local-preview.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.5",
    "ws": "^8.17.0",
    "@capacitor/core": "^7.4.3",
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "@capacitor/android": "^7.4.3",
    "@capacitor/cli": "^7.4.3"
  },
  "build": {
    "appId": "com.ovarist.auralis",
    "productName": "Auralis",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Auralis",
      "installerSidebar": "build/installer-sidebar.bmp",
      "uninstallerSidebar": "build/installer-sidebar.bmp",
      "installerHeader": "build/installer-header.bmp",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "uninstallDisplayName": "Auralis",
      "language": 1049,
      "artifactName": "Auralis-Setup-${version}.${ext}"
    },
    "files": [
      "electron-main.js",
      "preload.js",
      "local-preview.js",
      "public/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "ovaristed",
        "repo": "rustcordex",
        "releaseType": "release"
      }
    ]
  }
}
