# Server port
PORT=3000

# PostgreSQL Connection String (e.g. postgres://user:password@localhost:5432/rustcord)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/rustcord

# JWT signing secret
JWT_SECRET=super-secret-jwt-key-change-in-production

# GIF APIs (Optional - Wikimedia Commons works out of the box without keys)
GIPHY_API_KEY=
TENOR_API_KEY=

# WebRTC TURN Relay (Recommended for calls behind strict NAT/Firewalls)
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
